# Optional. `docker compose up -d` works without this file; copy it to docker/.env only to change something.
# PUBLIC_URL and AI_CLOUD_* can also be set in the gallery (Definições → Servidor); a value here wins and
# locks the field there.

# Host port for the app (ignored by compose.caddy.yml, which publishes 80/443 only).
# RECORTE_PORT=8080

# Public address of the gallery, exactly as typed in the browser (no trailing slash).
# PUBLIC_URL=http://192.168.1.20:8080

# Both create the owner account at the first start instead of the /setup wizard. Remove ADMIN_PASSWORD afterwards.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# HTTPS with Caddy (compose.caddy.yml): your domain, pointed at this host.
# DOMAIN=recorte.example.com

# Optional cloud AI (OpenAI-compatible) for titles/descriptions. Images are sent to that third party.
# AI_CLOUD_URL=
# AI_CLOUD_KEY=
# AI_CLOUD_MODEL=

# Only for compose.meili-external.yml (Meilisearch as a separate service).
# MEILI_MASTER_KEY=

# Image to run (default: the published one). Versions only matter for `docker compose build`
# (compute them with: node scripts/version.mjs).
# RECORTE_IMAGE=ghcr.io/qwickin/screenshotextension:latest
# APP_VERSION=0.0.0
# EXTENSION_VERSION=0.0.0

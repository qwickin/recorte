# Copy to docker/.env (next to compose.yml) and fill in.

# Required. Shared by the app and Meilisearch; at least 16 characters.
# Generate one with: openssl rand -base64 32
MEILI_MASTER_KEY=

# Public address of the gallery, exactly as typed in the browser (no trailing slash).
# Used for the Origin check and the setup link. Leave empty for http://localhost:8080.
PUBLIC_URL=

# Host port for the app (ignored by compose.caddy.yml, which publishes 80/443 only).
RECORTE_PORT=8080

# First run: either create the owner directly…
ADMIN_EMAIL=
ADMIN_PASSWORD=
# …or fix the /setup token (otherwise a random one is printed in the logs).
SETUP_TOKEN=

# HTTPS with Caddy (compose.caddy.yml): your domain, pointed at this host.
DOMAIN=

# Optional cloud AI (OpenAI-compatible) for titles/descriptions.
AI_CLOUD_URL=
AI_CLOUD_KEY=
AI_CLOUD_MODEL=

# Image to run (default: the published one). Versions only matter for `docker compose build`
# (compute them with: node scripts/version.mjs).
# RECORTE_IMAGE=ghcr.io/qwickin/screenshotextension:latest
# APP_VERSION=0.0.0
# EXTENSION_VERSION=0.0.0

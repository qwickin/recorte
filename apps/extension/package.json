{
  "name": "@recorte/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@recorte/shared": "workspace:*",
    "idb": "^8.0.4"
  }
}
